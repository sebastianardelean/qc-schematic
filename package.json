{
    "name": "qc-schematic",
    "version": "1.0.0",
    "description": "Quantum circuit schematic editor with an OpenQASM 3 editor.",
    "author": "QC Schematic",
    "private": true,
    "main": "main.cjs",
    "scripts": {
        "start": "electron .",
        "build:cljs": "shadow-cljs release app",
        "watch:cljs": "shadow-cljs watch app",
        "test": "shadow-cljs compile test && node out/node-test.js",
        "test:integration": "shadow-cljs compile integration && node out/integration-test.js",
        "test:system": "electron test/system/electron-entry.cjs",
        "test:all": "npm test && npm run test:integration && npm run test:system",
        "coverage": "shadow-cljs compile test && c8 --reporter=lcov --reporter=text-summary --temp-directory .c8tmp node out/node-test.js && node scripts/coverage.mjs",
        "dist": "npm run build:cljs && electron-builder --publish never",
        "dist:win": "npm run build:cljs && electron-builder --win --publish never",
        "dist:linux": "npm run build:cljs && electron-builder --linux --publish never",
        "dist:mac": "npm run build:cljs && electron-builder --mac --publish never",
        "pack": "npm run build:cljs && electron-builder --dir --publish never"
    },
    "keywords": [
        "quantum",
        "openqasm",
        "circuit",
        "electron"
    ],
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "c8": "^10.1.3",
        "electron": "^44.7.0",
        "electron-builder": "^26.15.3",
        "jsdom": "^25.0.1",
        "shadow-cljs": "^3.5.5"
    },
    "build": {
        "appId": "com.qcschematic.app",
        "productName": "QC Schematic",
        "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
        "asar": true,
        "directories": {
            "output": "dist",
            "buildResources": "build"
        },
        "files": [
            "main.cjs",
            "preload.cjs",
            "index.html",
            "styles.css",
            "public/js/**/*",
            "static/**/*"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "QC Schematic"
        },
        "mac": {
            "category": "public.app-category.developer-tools",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "linux": {
            "category": "Science",
            "synopsis": "Quantum circuit schematic editor",
            "maintainer": "QC Schematic",
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "deb",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        }
    }
}
