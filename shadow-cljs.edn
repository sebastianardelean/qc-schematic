{:source-paths ["src" "test"]

 :builds
 {:app
  {:target :browser
   :output-dir "public/js"
   :asset-path "js"
   :modules
   {:common
    {:entries [app.dom]
     :default true}
    :main
    {:entries [app.core]
     :depends-on #{:common}}
    :editor
    {:entries [app.editor.core]
     :depends-on #{:common}}}}

  :test
  {:target :node-test
   :output-to "out/node-test.js"
   :ns-regexp "-test$"
   :compiler-options {:source-map true}}

  :integration
  {:target :node-test
   :output-to "out/integration-test.js"
   :ns-regexp "integration-test$"
   :compiler-options {:source-map true}}}}
